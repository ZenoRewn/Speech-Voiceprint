# Speech_Voiceprint — local environment defaults.
#
# Usage:
#   cp .env.example .env
#   edit values, then run any of:
#     .venv/bin/python -m pipeline.api ...
#     .venv/bin/python -m pipeline.orchestrator ...
#     .venv/bin/python -m pipeline.streaming ...
#
# Each entry point loads `.env` from the current directory before reading
# os.environ. Variables already set in the shell take precedence over the
# file, so explicit `export FOO=bar` still wins.
#
# DO NOT commit your real .env — it's in .gitignore.

# ---- Azure Speech (required for fast / batch / realtime) ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# ---- HuggingFace (only needed for the pyannote backend) ----
# Get one at https://huggingface.co/settings/tokens and accept the licenses
# at huggingface.co/pyannote/speaker-diarization-community-1 + /embedding.
HF_TOKEN=

# ---- API server ----
# Set to enable Bearer auth on every REST + WS route. Leave empty for dev.
SV_API_TOKEN=
# 1 = JSON-line logs (for fluent-bit / Vector). Empty = human-readable.
SV_LOG_JSON=
# DEBUG / INFO / WARNING / ERROR. Default INFO.
SV_LOG_LEVEL=
# Default registry path when --registry not passed. Accepts either a bare
# filesystem path (treated as SQLite) or a URI: `sqlite:///abs/path.db` or
# `mysql+pymysql://user:pass@host:3306/db`. MySQL support requires installing
# the optional extra: pip install -e ".[mysql]". Empty = default to
# <SV_DATA_DIR>/registry/speakers.db.
SV_REGISTRY_PATH=
# Data root. Defaults to <repo>/data/. Holds resources/, uploads/, stream/,
# outputs/, registry/. Each subdir is also overridable individually:
#   SV_RESOURCES_DIR=, SV_UPLOADS_DIR=, SV_STREAM_DIR=,
#   SV_OUTPUTS_DIR=, SV_REGISTRY_DIR=
SV_DATA_DIR=
# How many seconds the api waits for in-flight jobs before exiting on SIGTERM.
# K8s `terminationGracePeriodSeconds` should be ≥ this value. Default 60.
SV_SHUTDOWN_TIMEOUT=
# Max multipart upload size in bytes. Default 209715200 (200 MiB).
SV_MAX_UPLOAD_BYTES=

# ---- VAD ----
# 1 = skip silero, force RMS energy gate (offline / no torch).
SV_VAD_FORCE_RMS=
